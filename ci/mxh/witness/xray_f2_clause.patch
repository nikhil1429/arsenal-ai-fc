+        if (lastStop(line.slice(0, fm.index)) >= 0 || foreignNamed(f, clauseBefore(head, m.index + fm.index))) continue;
+        declared.push({ organ: f, file: fm[1] });
+      }
       if (/capsules\//.test(line)) declared.push({ organ: f, file: "capsules/" });
     }
   }
