#!/bin/sh
# ============================================================================
# hooks/pre-commit · ARSENAL AI FC — THE ARCHIVE TRIPWIRE
# ----------------------------------------------------------------------------
# WHY: the repo is PUBLIC and a push cannot be taken back. Forks, clones and
#   GitHub's dangling-commit cache mean a later delete is not an erase, so the
#   only place to stop a personal-capture lane or the archive itself is BEFORE
#   the commit exists.
# WHAT IT REFUSES: any staged file inside a BagIt bag (i.e. the archive), any
#   bag file by name, live Oura credentials, and any dressing-room/*.jsonl that
#   git has NEVER TRACKED (a brand-new capture lane). Lanes already tracked on
#   purpose keep committing normally — a hook that reds every commit gets
#   uninstalled, and an uninstalled hook protects nothing.
# OVERRIDE (new lanes only, never credentials, never the bag):
#   ARSENAL_ALLOW_NEW_LANE=1 git commit …
# FAIL-OPEN, DELIBERATELY: if node is missing the commit proceeds and says so.
#   A tripwire that blocks all work when its runtime is absent gets removed.
# INSTALL: powershell -File setup\INSTALL_ARCHIVE.ps1   (copies this to
#   .git/hooks/pre-commit). Re-run it after any clone — .git/hooks is not
#   versioned, which is exactly why the source of truth is this tracked file.
# ============================================================================
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found — ARCHIVE TRIPWIRE IS OFF for this commit. Check staged paths by hand."
  exit 0
fi
# ── BELT 1 · THE ARCHIVE TRIPWIRE (14 Aug 2026) — unchanged, and it still runs FIRST.
node scripts/archivist.mjs tripwire || exit 1
# ── BELT 2 · THE ORDER-CHECKER (AUDIT §10-C rung S1c, 20 Aug 2026).
# §3-C's question — "have you checked the entire file byte by byte?" — cannot be answered
# by reading it again; four readings each found what the last one missed. So it is a gate:
# every order file in docs/archive (found by predicate, never by a list) is checked for
# UTF-8 integrity, balanced fences, dangling §references, named files that do not exist and
# commands whose organ has no such verb. It BLOCKS on the OPEN order only — a closed record
# prints LEADS and never holds a commit hostage (§10-H: a record is never edited).
node scripts/rails.mjs orders --quiet || exit 1
exit 0
